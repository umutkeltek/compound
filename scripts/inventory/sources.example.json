{
 "schema_version": "compound.system_inventory_sources.v0.1",
 "sources": [
  {
   "id": "aws-example-prod",
   "provider": "aws",
   "label": "Example production account",
   "profile": "example-prod",
   "region": "eu-example-1",
   "max_resources": 2000,
   "timeout_s": 60,
   "places": ["aws"]
  },
  {
   "id": "aws-example-old",
   "provider": "aws",
   "enabled": false,
   "note": "the sign-in expired on the last check; enable after signing in again",
   "label": "Example old account",
   "profile": "example-old"
  },
  {
   "id": "pve-example",
   "provider": "pve",
   "label": "Example virtualization node",
   "ssh_alias": "pve.example",
   "timeout_s": 30
  },
  {
   "id": "vps-example",
   "provider": "ssh_host",
   "label": "Example rented server",
   "ssh_alias": "vps.example",
   "places": ["example_vps"]
  },
  {
   "id": "dns-example",
   "provider": "cloudflare",
   "command": ["example-dns-cli", "api", "GET", "/zones?per_page=50&page={page}"],
   "account_labels": {"a1b2": "Example DNS account"},
   "search_console_source": "search-example",
   "max_pages": 10
  },
  {
   "id": "search-example",
   "provider": "search_console",
   "label": "Example search account",
   "command": ["example-search-cli", "sites", "list", "--account", "owner@example.invalid", "--json"]
  },
  {
   "id": "credit-example",
   "provider": "balance_http",
   "vendor": "example_models",
   "label": "Example prepaid model credit",
   "url": "https://api.example/v1/balance",
   "token_env": "EXAMPLE_API_KEY",
   "balance_path": "balance_infos[0].total_balance",
   "unit_path": "balance_infos[0].currency",
   "env_unset": ["HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy", "ALL_PROXY", "all_proxy"],
   "timeout_s": 15
  },
  {
   "id": "seats-example",
   "provider": "json_file",
   "path": "~/example-usage/usage-history.jsonl",
   "plans": [
    {
     "label": "Example assistant seat, weekly window",
     "vendor": "example_ai",
     "match": {"provider": "example_ai", "windowKind": "weekly"},
     "group_by": "accountKey",
     "observed_at_path": "sampledAt",
     "max_age_hours": 48,
     "facts": {"window_used_pct": "usedPercent", "resets_at": "resetsAt"}
    }
   ]
  }
 ]
}
